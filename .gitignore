# Dependencies and build output (rebuilt with npm install / npm run build)
node_modules/
dist/
dist-electron/

# Per-machine: which GB Studio project the dev server opens, and the backups GB Cartographer keeps before writing
cartographer.local.json
backups/

# OS / editor clutter
.DS_Store
Thumbs.db
*.log

# Never commit a GB Studio project (except the app's own demo)
*.gbsproj
!demo/demo.gbsproj

# The dev server's painted copy of the demo project (the shipped one is demo/), and its Map Room layouts
demo-project/
maps/

# Design mockups and review screenshots (local only)
review/

# Private working files: the to-do list and plan, notes for Claude, the dev log, the internal spec,
# the author's per-tile coloring record, and Claude's launch config. They live only on the author's machines.
TODO.md
CLAUDE.md
PROGRESS.md
docs/SPEC.md
docs/demo-tile-palettes.json
.claude/

# Other people's art stays on the author's machines until its artists have given their blessing (2026-10-10):
# the demo's pictures, and old screenshots that show them. GB Cartographer's own graphics (src/graphics) ship.
demo/assets/**/*.png
# …except the demo's CC0 fonts (2026-10-13: Public Pixel by GGBotNet, Varigram, made from monogram by datagoblin)
!demo/assets/fonts/Public Pixel (GGBotNet).png
!demo/assets/fonts/Varigram.png
docs/*.png
docs/*.gif
# …except the author's own demo GIFs (2026-10-10: "put back the gifs i made")
!docs/demo.gif
!docs/demo-spray.gif
!docs/demo-select-move.gif
!docs/demo-pencil.gif
!docs/screenshot-paint-directly.png
demo/Cartographer/

# Installers made by electron-builder (npm run dist)
release/
